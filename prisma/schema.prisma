// Prisma schema for the UA agency platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  SALES
}

// Which discipline a user serves in on a specific project.
enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
}

enum BudgetType {
  FIXED
  HOURLY
  RETAINER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  ONBOARDING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique // optional login handle; sign in with this or email
  passwordHash String?
  mustChangePassword Boolean @default(false) // true after admin creates them with a temp password; forces a reset on first login
  roles        Role[]   @default([])
  timezone     String?  // IANA tz of where this person works, e.g. "Asia/Karachi"
  notifyPrefs  Json?    // per-category push toggles, e.g. { leads: true, messages: false }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks     Task[]             @relation("TaskAssignee")
  timeEntries       TimeEntry[]
  projectMembers    ProjectMember[]
  salesLeads        Client[]           @relation("SalesLeads")
  commissionPayouts CommissionPayout[]
  salaries          Salary[]
  salaryPayments    SalaryPayment[]
  expensesPaid      Expense[]          @relation("ExpensePaidBy")
  leaveRequests     LeaveRequest[]     @relation("UserLeave")
  uploadedFiles     FileAsset[]        @relation("UploadedFiles")
  fileComments      FileComment[]      @relation("FileComments")
  assistantMessages AssistantMessage[] @relation("AssistantMessages")
  loginsCreated     Login[]            @relation("LoginCreatedBy")
  loginShares       LoginShare[]       @relation("LoginShares")
  notifications     Notification[]     @relation("Notifications")
  pushSubscriptions PushSubscription[]
  conversationMemberships ConversationMember[] @relation("ConversationMemberships")
  messagesSent      Message[]          @relation("MessagesSent")
  commentThreads    CommentThread[]    @relation("ThreadCreatedBy")
  comments          Comment[]          @relation("CommentAuthor")
  statements        Statement[]        @relation("UploadedStatements")
  letters           Letter[]           @relation("LettersCreated")
  pendingImports    PendingImport[]    @relation("PendingImportsCreated")
  meetingsRequested Meeting[]          @relation("MeetingRequester")
  meetingsToApprove Meeting[]          @relation("MeetingApprover")
  meetingAttendances MeetingAttendee[] @relation("MeetingAttendees")

  @@index([email])
}

// Resolvable comment threads (Figma-style) attachable to any entity
// (project / task / client). The first comment opens the thread; the rest are
// replies. @mentions notify the tagged user.
model CommentThread {
  id          String    @id @default(cuid())
  entityType  String // 'project' | 'task' | 'client'
  entityId    String
  resolved    Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation("ThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
}

model Comment {
  id        String        @id @default(cuid())
  threadId  String
  thread    CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

// Direct & group messaging.
model Conversation {
  id          String               @id @default(cuid())
  isGroup     Boolean              @default(false)
  title       String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  deletedAt      DateTime? // soft-delete: hidden from the list, kept for 30 days
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation("MessagesSent", fields: [senderId], references: [id], onDelete: SetNull)
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// In-app notifications (mentions, approvals, shares, leave requests, …).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Shared login credentials (a small team vault). Passwords are stored encrypted
// (AES-256-GCM) and only decrypted on demand for authorized users.
model Login {
  id          String       @id @default(cuid())
  name        String
  url         String?
  username    String?
  passwordEnc String // encrypted blob — never the plaintext
  notes       String?
  createdById String?
  createdBy   User?        @relation("LoginCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shares      LoginShare[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdById])
}

// Who a given login is shared with. Managers (super admin / admin / PM) see all.
model LoginShare {
  id        String   @id @default(cuid())
  loginId   String
  login     Login    @relation(fields: [loginId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("LoginShares", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([loginId, userId])
  @@index([userId])
}

// Persisted analytics-assistant chat, per user. Token/cost columns power the
// super-admin "credits used" view; everyone can read their own history.
model AssistantMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("AssistantMessages", fields: [userId], references: [id], onDelete: Cascade)
  role             String // 'user' | 'assistant'
  content          String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  model            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model Client {
  id           String        @id @default(cuid())
  // Contact
  name         String        // business / client name
  contactName  String?       // primary contact person
  email        String?
  phone        String?
  source       String?
  sourceOther  String?       // when source = OTHER
  industry     String?
  location     String?       // optional geographic location
  website      String?       // current website
  socialLinks  String?       // free text / links
  notes        String?
  // Lead attribution for sales commission
  leadType      String?
  taxRegion     String?   // 'QC' | 'CA' | 'US' — drives invoice tax
  driveFolderId String?   // this client's Google Drive folder
  salespersonId String?
  salesperson   User?     @relation("SalesLeads", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  projects Project[]
  payments Payment[]
  invoices Invoice[]

  // Set when this client was converted from a sourced Lead.
  convertedFromLead Lead? @relation("LeadConversion")

  @@index([salespersonId])
}

model Project {
  id              String        @id @default(cuid())
  name            String
  type            String
  description     String?
  targetAudience  String?
  referenceLinks  String?

  // Budget
  budgetAmount    Float?
  budgetCurrency  String?       @default("USD")
  budgetType      BudgetType?

  // Timeline
  startDate       DateTime?
  deadline        DateTime?
  deadlineEventId   String? // Google Calendar event mirroring the deadline (if synced)
  deadlineSyncedFor DateTime? // the deadline value last synced, to detect changes
  driveFolderId     String? // this project's Google Drive folder
  priority        Priority      @default(MEDIUM)

  // Assets & links (v1 = links only)
  figmaLink       String?
  fileLinks       String?       // pasted URLs, one per line
  brandAssetsLink String?
  domainAccess    String?       // notes / access for dev projects

  status          ProjectStatus @default(ONBOARDING)
  internalNotes   String?
  pmCommissionRate Float        @default(10) // % of project value / payments to the PM

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  tasks       Task[]
  timeEntries TimeEntry[]
  payments    Payment[]
  invoices    Invoice[]
  files       FileAsset[]

  @@index([clientId])
  @@index([status])
}

// Join: a user assigned to a project in a particular discipline.
// Multiple people per role, and a person could hold multiple roles on a project.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tags Tag[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  tasks Task[]
}

// User-editable dropdown options. `kind` groups them (projectType, clientSource,
// expenseCategory, fileCategory, paymentMethod, currency, leadType). `value` is
// the stored string; `label` is shown; `rate` is the commission % for leadType.
// Singleton company profile (used on invoices, receipts, contracts).
model CompanySetting {
  id        String   @id @default("default")
  name      String   @default("UA Agency")
  email     String?
  phone     String?
  website   String?
  address   String?
  gstNumber String?
  qstNumber String?
  neqNumber String?
  corporationNumber    String? // federal corporation / business number
  identificationNumber String? // Revenu Québec identification number
  gstRate   Float    @default(5)
  qstRate   Float    @default(9.975)
  updatedAt DateTime @updatedAt
}

model OptionItem {
  id        String   @id @default(cuid())
  kind      String
  value     String
  label     String
  rate      Float?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@index([kind])
}

// A recorded commission payout to a team member (sales or PM). Amount in CAD.
model CommissionPayout {
  id        String   @id @default(cuid())
  amount    Float
  paidAt    DateTime
  method    String?
  note      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A file stored in the Google Shared Drive, indexed against a project.
model FileAsset {
  id          String       @id @default(cuid())
  name        String
  category    String       @default("OTHER")
  driveFileId String
  webViewLink String?
  mimeType    String?
  size        Int?
  createdAt   DateTime     @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)

  comments FileComment[]

  @@index([projectId])
}

model FileComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  fileId String
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?    @relation("FileComments", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([fileId])
}

// An invoice for a project (or client). Number auto-increments.
model Invoice {
  id        String        @id @default(cuid())
  number    Int           @unique @default(autoincrement())
  status    InvoiceStatus @default(DRAFT)
  amount    Float
  currency  String        @default("USD")
  issuedAt  DateTime      @default(now())
  dueAt     DateTime?
  notes     String?
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  // Source tracking for invoices synced from an external system (e.g. Wave).
  externalSource String? // e.g. "WAVE"
  externalId     String? @unique // the source system's invoice id (dedupe key)
  externalNumber String? // the human invoice number from the source

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Payments applied to this invoice (receivables reconciliation).
  payments Payment[]

  @@index([clientId])
  @@index([projectId])
}

// A business expense (any currency, normalized to CAD).
model Expense {
  id        String          @id @default(cuid())
  title     String
  category  String          @default("OTHER")
  amount    Float
  currency  String          @default("CAD")
  amountCad Float?
  fxRate    Float?
  // Input tax credits: the GST/QST portion backed out of a taxable purchase
  // (in the expense's own currency, CAD in practice). null = no tax tracked.
  gst       Float?
  qst       Float?
  date      DateTime        // the date the expense applies to
  note      String?
  // Set when this row was created by a statement import, so the import can be
  // cleared/re-done as a unit. References Statement.id (no FK cascade).
  statementId String?
  createdAt DateTime        @default(now())

  // Who fronted the money. null = paid by the company directly.
  paidById     String?
  paidBy       User?     @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reimbursed   Boolean   @default(false) // only meaningful when paidById is set
  reimbursedAt DateTime?

  @@index([date])
  @@index([paidById])
  @@index([statementId])
}

// Money the company has given out (advances, loans, opening balances) that
// still has to be recovered. Outstanding = amountCad − recoveredAmount.
model Loan {
  id              String   @id @default(cuid())
  counterparty    String   // who received it / who owes it back
  note            String?
  amount          Float
  currency        String   @default("CAD")
  amountCad       Float?
  recoveredAmount Float    @default(0) // total recovered so far, in CAD
  givenAt         DateTime
  createdAt       DateTime @default(now())

  @@index([givenAt])
}

// Salary progression: one row per salary change for a user (latest = current).
model Salary {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("CAD")
  effectiveFrom DateTime
  note          String?
  createdAt     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A salary payment to a user (any currency, normalized to CAD).
model SalaryPayment {
  id        String   @id @default(cuid())
  amount    Float
  currency  String   @default("CAD")
  amountCad Float?
  paidAt    DateTime
  method    String?
  note      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A check-in / check-out session. checkOutAt null = still checked in (open).
model TimeEntry {
  id            String    @id @default(cuid())
  checkInAt     DateTime
  checkOutAt    DateTime?
  hours         Float?
  tasks         String?
  notes         String?
  source        String    @default("SELF") // SELF | ADMIN
  activeSeconds Int       @default(0) // accumulated active (non-idle) time
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

// Vacation / sick / absence. Members request (PENDING); admins approve/reject,
// or add an absence directly (created APPROVED).
model LeaveRequest {
  id          String    @id @default(cuid())
  type        String    @default("VACATION") // VACATION | SICK | ABSENT | UNPAID | OTHER
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdById String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation("UserLeave", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Lightweight audit of task changes, used to auto-fill "tasks done" at checkout.
// Stored as denormalized snapshots so it survives task/project deletion.
model TaskActivity {
  id        String   @id @default(cuid())
  userId    String?
  taskId    String?
  projectId String?
  summary   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A payment received from a client (optionally tied to a specific project).
model Payment {
  id        String        @id @default(cuid())
  amount    Float
  currency  String        @default("USD")
  amountCad Float?        // amount converted to CAD at the rate when recorded
  fxRate    Float?        // currency -> CAD rate used at record time
  method    String        @default("BANK_TRANSFER")
  paidAt    DateTime
  note      String?
  createdAt DateTime      @default(now())

  // GST/QST collected on this payment (CAD). Set on import; when null the
  // quarterly calc falls back to backing it out by the client's province.
  gst       Float?
  qst       Float?

  // Bank reconciliation: set when this payment was matched to a statement credit.
  bankMatchedAt DateTime?
  // Set when created by a statement import (for clearing/re-doing an import).
  statementId   String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Optional link to the invoice this payment settles (receivables reconciliation).
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([statementId])
}

// Income that is NOT a client payment — e.g. an unmatched bank credit, a refund,
// or interest. Kept separate so client-payment revenue stays the source of truth,
// but still rolled into the Finance P&L income line. Excluded from GST/QST
// remittance (it isn't sales tax charged to a client).
model OtherIncome {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("OTHER")
  amount    Float
  currency  String   @default("CAD")
  amountCad Float?
  fxRate    Float?
  // GST/QST collected on this income (CAD), when tax was charged.
  gst       Float?
  qst       Float?
  date      DateTime
  note      String?
  source    String   @default("MANUAL") // MANUAL | STATEMENT
  statementId String? // set when created by a statement import
  createdAt DateTime @default(now())

  @@index([date])
  @@index([statementId])
}

// Per-quarter GST/QST remittance state: an optional manual income override plus
// the "received" toggles and filing confirmation. The collected/paid figures
// themselves are computed live from payments + expenses.
model QuarterlyFiling {
  id                String    @id @default(cuid())
  year              Int
  quarter           Int // 1..4
  incomeOverrideCad Float?    // overrides the auto income base when set
  gstReceived       Boolean   @default(false)
  gstReceivedAt     DateTime?
  qstReceived       Boolean   @default(false)
  qstReceivedAt     DateTime?
  filedAt           DateTime?
  filingLink        String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([year, quarter])
}

// An archived bank / credit-card statement file (PDF or CSV), stored inline in
// the database so it can be opened and viewed from the platform. Independent of
// the transactions imported from it.
model Statement {
  id           String   @id @default(cuid())
  accountType  String   @default("BANK") // BANK | CREDIT_CARD
  accountLabel String                    // free text, e.g. "Scotiabank chequing", "Amex Platinum"
  fileName     String
  mimeType     String   @default("application/pdf")
  size         Int      @default(0)
  data         Bytes                     // the raw file bytes
  periodLabel  String?                   // optional, e.g. "June 2026"
  note         String?
  source       String   @default("UPLOAD") // UPLOAD | IMPORT
  importedExpenses Int  @default(0)
  importedIncome   Int  @default(0)
  createdAt    DateTime @default(now())

  uploadedById String?
  uploadedBy   User?    @relation("UploadedStatements", fields: [uploadedById], references: [id], onDelete: SetNull)

  taskAttachments TaskAttachment[]

  @@index([accountType])
  @@index([createdAt])
}

// An uploaded letter / document (e.g. a government notice). The original file is
// stored inline; AI fills in the English translation, summary, and metadata, and
// each letter gets its own board of tasks (LetterTask) to work through.
model Letter {
  id           String    @id @default(cuid())
  title        String
  sender       String?
  reference    String?   // reference / file number on the letter
  docDate      DateTime? // the date printed on the letter
  dueDate      DateTime? // overall deadline, if any
  language     String    @default("en") // detected source language
  summary      String?   // English summary
  translation  String?   // English translation (when the source isn't English)
  originalText String?   // extracted source text
  status       String    @default("READY") // READY | FAILED
  errorNote    String?
  fileName     String
  mimeType     String    @default("application/pdf")
  size         Int       @default(0)
  data         Bytes     // original file bytes
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdById  String?
  createdBy    User?     @relation("LettersCreated", fields: [createdById], references: [id], onDelete: SetNull)

  tasks LetterTask[]

  @@index([createdAt])
}

// A single action item on a letter's board.
model LetterTask {
  id        String    @id @default(cuid())
  title     String
  titleFr   String?   // the action/question phrased in French (for the submission PDF)
  detail    String?
  detailFr  String?   // French version of the detail
  response  String?   // the written answer to this task/question
  status    String    @default("TODO") // TODO | DOING | DONE
  dueDate   DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  letterId String
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  attachments TaskAttachment[]

  @@index([letterId])
}

// A file attached as evidence to a letter task — either freshly uploaded (bytes
// stored inline) or a reference to an already-archived Statement.
model TaskAttachment {
  id          String     @id @default(cuid())
  kind        String     @default("UPLOAD") // UPLOAD | STATEMENT
  fileName    String
  mimeType    String     @default("application/octet-stream")
  size        Int        @default(0)
  data        Bytes?     // present for UPLOAD; null when referencing a Statement
  // For generated finance reports: the PDF+CSV pair share a reportKey, and
  // reportSpec stores the params so the report can be regenerated with live data.
  reportKey   String?
  reportSpec  Json?
  createdAt   DateTime   @default(now())

  taskId      String
  task        LetterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  statementId String?
  statement   Statement? @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([statementId])
}

// A saved-for-later statement import: one uploaded statement's parsed + reviewed
// lines (stored as JSON) plus the original file, so it can be reviewed in tabs
// and committed later. Deleted once committed.
model PendingImport {
  id           String   @id @default(cuid())
  fileName     String
  accountType  String   @default("BANK") // BANK | CREDIT_CARD
  accountLabel String
  currency     String   @default("CAD")
  note         String?
  lines        Json     // Line[]: { include, type, title, category, amount, date, rawDesc, tax, clientId }
  mimeType     String   @default("application/pdf")
  data         Bytes?   // original file, archived to Statements on commit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById  String?
  createdBy    User?    @relation("PendingImportsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// A money movement that is NOT income or an expense — e.g. paying down the
// business credit card from the bank, or moving money between own accounts.
// Recorded for visibility/audit but excluded from the P&L and GST/QST, so a
// credit-card payment isn't double-counted against the card's purchases.
model Transfer {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("CREDIT_CARD_PAYMENT") // CREDIT_CARD_PAYMENT | INTERNAL | OTHER
  amount    Float
  currency  String   @default("CAD")
  amountCad Float?
  fxRate    Float?
  date      DateTime
  note      String?
  source    String   @default("STATEMENT") // STATEMENT | MANUAL | RECLASSIFIED
  statementId String? // set when created by a statement import
  createdAt DateTime @default(now())

  @@index([date])
  @@index([statementId])
}

// Learned categorization for recurring statement transactions. Keyed by a
// normalized description (see lib/txnrules.ts): remembers the type/category and
// (for deliberate renames) the title you last chose, so future imports pre-fill.
model TxnRule {
  id        String   @id @default(cuid())
  matchKey  String   @unique
  type      String   @default("expense") // expense | income | transfer
  category  String
  title     String?  // learned only when you rename (not just the raw description)
  tax       String?  // learned tax treatment: none | gst | both
  hits      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Lead generation ─────────────────────────────────────────────────────────
// Sourced prospects (pre-Client). A "won" lead converts into a Client above.

// A target company a lead works at.
model LeadCompany {
  id            String   @id @default(cuid())
  name          String
  domain        String?  @unique
  industry      String?
  employeeCount Int?
  location      String?
  linkedinUrl   String?
  description   String?
  createdAt     DateTime @default(now())

  leads Lead[]
}

// A sourced person (the prospect we contact).
model Lead {
  id          String   @id @default(cuid())
  firstName   String?
  lastName    String?
  title       String?
  email       String?  @unique
  emailStatus String   @default("unknown") // unknown | verified | risky | invalid
  phone       String?
  linkedinUrl String?

  source     String  @default("apollo")
  externalId String? @unique // provider dedupe key (e.g. Apollo person id)
  segment    String? // which ICP segment this lead was sourced for

  score      Int     @default(0)
  status     String  @default("new") // new | scored | queued | contacted | replied | won | lost | unqualified
  smsConsent Boolean @default(false) // TCPA: only true if opted in

  companyId String?
  company   LeadCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Set once this lead is converted into a real Client.
  convertedClientId String? @unique
  convertedClient   Client? @relation("LeadConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities  LeadActivity[]
  enrollments SequenceEnrollment[]

  @@index([status])
  @@index([segment])
  @@index([companyId])
}

// A reusable multi-step outreach campaign (one per ICP segment).
model Sequence {
  id        String   @id @default(cuid())
  key       String   @unique // matches an ICP segment key
  name      String
  channel   String   @default("multi") // email | linkedin | sms | multi
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

// One touch within a sequence.
model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  channel    String   @default("email") // email | linkedin | sms
  delayDays  Int      @default(0) // days to wait after the previous step
  subject    String? // email only
  body       String // supports {{firstName}}, {{company}} tokens

  @@unique([sequenceId, order])
}

// Tracks one lead moving through one sequence.
model SequenceEnrollment {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId   String
  sequence     Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep  Int       @default(0)
  status       String    @default("active") // active | completed | stopped
  nextActionAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([leadId, sequenceId])
}

// Working hours we've committed to a partner agency (who may be in another
// timezone). Shown as live clocks + an open/closed indicator. One weekly window.
model AgencySchedule {
  id        String   @id @default(cuid())
  name      String
  timezone  String   // IANA tz, e.g. "Asia/Karachi"
  days      Int[]    // working days, 0=Sun … 6=Sat
  startMin  Int      @default(540)  // window start, minutes from midnight (09:00)
  endMin    Int      @default(1020) // window end, minutes from midnight (17:00)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only log of everything that happens to a lead.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // sourced | scored | email_sent | replied | linkedin_task | note | ...
  channel   String? // email | linkedin | sms
  detail    String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// A keyword/query the X (Twitter) listener watches for buying-intent tweets.
model TweetKeyword {
  id        String   @id @default(cuid())
  query     String   @unique // an X advanced-search query, e.g. "need a web designer"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A tweet surfaced by the X listener as a potential lead/buying signal.
// Fetched via a third-party X data API (twitterapi.io) — no X login required.
model TweetLead {
  id           String   @id @default(cuid())
  tweetId      String   @unique // X status id (provider dedupe key)
  url          String // canonical tweet URL, opened in the user's own logged-in browser
  text         String
  lang         String?
  authorId     String? // numeric X user id (for DM compose links)
  authorHandle String? // @handle
  authorName   String?
  authorAvatar String?
  likeCount    Int      @default(0)
  replyCount   Int      @default(0)
  postedAt     DateTime?
  matchedQuery String? // which TweetKeyword surfaced it

  // Learning: the user marks each tweet relevant/not; those labels are fed back
  // to the classifier as examples so future scoring matches their taste.
  relevance String @default("unknown") // unknown | yes | no
  aiScore   Int? // 0–100 model estimate of how good a lead this is
  aiReason  String? // one-line model rationale
  draft     String? // AI-drafted reply the user can edit / send
  status    String @default("new") // new | contacted | ignored
  notified  Boolean @default(false) // a lead alert has already been sent for this tweet

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([relevance])
  @@index([createdAt])
}

// A browser/phone push subscription (Web Push), so the platform can send
// notifications to a device even when the app isn't open.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Integration credentials set from Settings → Integrations (instead of only
// Railway env vars), so the app can be configured from the dashboard. Values are
// encrypted at rest; env vars remain a fallback when no row is saved.
model AppSecret {
  name      String   @id // the env-var name, e.g. TWITTERAPI_IO_KEY
  value     String // AES-256-GCM ciphertext (v1:iv:tag:ct)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── Meetings ─────────────────────────────────────────────────────────────────
// Internal meeting scheduling with an approval flow. A requester asks to meet an
// approver (optionally proposing a time, or asking for their availability); the
// approver confirms/declines. On approval it's booked, optionally synced to
// Google Calendar with a Meet link, and everyone involved is notified.
enum MeetingStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELLED
}

model Meeting {
  id          String        @id @default(cuid())
  title       String
  description String?
  clientName  String? // potential client to discuss
  status      MeetingStatus @default(REQUESTED)

  requesterId String
  requester   User   @relation("MeetingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User   @relation("MeetingApprover", fields: [approverId], references: [id], onDelete: Cascade)

  // Proposed / confirmed time. Null start = "ask for the approver's availability".
  startAt     DateTime?
  endAt       DateTime?
  durationMin Int       @default(30)

  proposedByApprover Boolean @default(false) // approver counter-proposed a time
  declineReason      String?
  reminderSentAt     DateTime? // set once the pre-meeting reminder has gone out

  withMeet       Boolean @default(true)
  meetLink       String?
  googleEventId  String?
  googleHtmlLink String?

  attendees MeetingAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approverId, status])
  @@index([requesterId])
  @@index([startAt])
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String? // internal attendee
  user      User?   @relation("MeetingAttendees", fields: [userId], references: [id], onDelete: Cascade)
  email     String? // external attendee (client)

  @@index([meetingId])
  @@index([userId])
}
