# Copy to .env and fill in. .env is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ua:ua_local_dev@localhost:5432/ua_platform?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app, used for login links in welcome emails.
# On Railway this falls back to RAILWAY_PUBLIC_DOMAIN if unset.
APP_URL=""

# ─── Welcome emails ──────────────────────────────────────────────────────────
# When a team member is added they always get a username + temporary password
# (shown to the admin, and forced to change on first login). Set this to "true"
# to ALSO email those details to the new member. Off by default while in dev —
# the credentials are still shown in-app. Requires RESEND_API_KEY.
WELCOME_EMAILS_ENABLED="false"

# ─── Connect Google (OAuth) — one connection for Gmail, Calendar, Meet, Drive ─
# Create an OAuth client (Web app) in Google Cloud; enter these in Settings →
# Integrations and click "Connect Google". The refresh token + connected email
# are captured by the connect flow (no need to set them by hand).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN / GOOGLE_CONNECTED_EMAIL are captured on connect.
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_TZ="America/Toronto"
# How many minutes before a meeting to send the reminder (cron task=reminders).
MEETING_REMINDER_LEAD_MIN="30"

# ─── Email (Resend) — fallback used only when Google isn't connected ─────────
RESEND_API_KEY=""
INVOICE_FROM_EMAIL="invoices@youragency.com"

# ─── Google Drive (legacy service-account fallback, optional) ────────────────
# Only used if you don't connect Google above. Service-account JSON + Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SHARED_DRIVE_ID=""

# ─── Analytics chatbot (OpenRouter + Kimi) ───────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="moonshotai/kimi-k2"
